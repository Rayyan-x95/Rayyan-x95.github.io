            align-items: center;
            gap: 0.75rem;
        }
        
        .section-title i {
            font-size: 1.25rem;
        }
        
        .summary {
            font-size: 1rem;
            line-height: 1.8;
            color: var(--text-secondary);
        }
        
        .experience-item,
        .education-item {
            margin-bottom: 2rem;
        }
        
        .experience-item:last-child,
        .education-item:last-child {
            margin-bottom: 0;
        }
        
        .item-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 0.75rem;
            flex-wrap: wrap;
            gap: 0.5rem;
        }
        
        .item-title {
            font-size: 1.125rem;
            font-weight: 700;
            color: var(--text-primary);
        }
        
        .item-company {
            font-size: 1rem;
